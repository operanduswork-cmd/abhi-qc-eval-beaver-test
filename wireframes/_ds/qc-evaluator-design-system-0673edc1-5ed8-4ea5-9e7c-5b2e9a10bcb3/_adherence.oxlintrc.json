{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "assets/icons/**",
              "components/controls/**",
              "components/evidence/**",
              "components/icon/**",
              "components/progress/**",
              "components/rubric/**",
              "components/scoring/**",
              "ui_kits/qc-evaluator-app/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Poppins))/i]",
        "message": "Font not provided by the design system. Available: Poppins."
      },
      {
        "selector": "JSXOpeningElement[name.name='BandRail'] > JSXAttribute > JSXIdentifier[name!=/^(?:band|caption|showLabels|key|ref|className|style|children)$/]",
        "message": "<BandRail> doesn't accept that prop. Declared props: band, caption, showLabels."
      },
      {
        "selector": "JSXOpeningElement[name.name='BandRail'] > JSXAttribute[name.name='band'] > Literal[value!=/^(?:fail|at-risk|inconsistent|strong|elite)$/]",
        "message": "<BandRail> band must be one of 'fail' | 'at-risk' | 'inconsistent' | 'strong' | 'elite'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|icon|iconRight|disabled|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, icon, iconRight, disabled."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|ghost)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'ghost'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:small|default|large)$/]",
        "message": "<Button> size must be one of 'small' | 'default' | 'large'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CapNotice'] > JSXAttribute > JSXIdentifier[name!=/^(?:state|showGlyph|children|key|ref|className|style|children)$/]",
        "message": "<CapNotice> doesn't accept that prop. Declared props: state, showGlyph, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='CapNotice'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:FIRED|INDETERMINATE|NOT_FIRED)$/]",
        "message": "<CapNotice> state must be one of 'FIRED' | 'INDETERMINATE' | 'NOT_FIRED'."
      },
      {
        "selector": "JSXOpeningElement[name.name='EvidenceCitation'] > JSXAttribute > JSXIdentifier[name!=/^(?:line|speaker|quote|contradicts|degraded|key|ref|className|style|children)$/]",
        "message": "<EvidenceCitation> doesn't accept that prop. Declared props: line, speaker, quote, contradicts, degraded."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|strokeWidth|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, strokeWidth."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute[name.name='name'] > Literal[value!=/^(?:kick-off|coaching|contradiction|evidence|transcript|talk-share|cap|verified|failed|cap-fired|indeterminate|not-applicable|not-evidenced|queued|scoring|degraded|unobservable|complete|worker-died|download|retry|copy|chevron|back|external|search|menu|caret|add|info|discard)$/]",
        "message": "<Icon> name must be one of 'kick-off' | 'coaching' | 'contradiction' | 'evidence' | 'transcript' | 'talk-share' | 'cap' | 'verified' | 'failed' | 'cap-fired' | 'indeterminate' | 'not-applicable' | 'not-evidenced' | 'queued' | 'scoring' | 'degraded' | 'unobservable' | 'complete' | 'worker-died' | 'download' | 'retry' | 'copy' | 'chevron' | 'back' | 'external' | 'search' | 'menu' | 'caret' | 'add' | 'info' | 'discard'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|placeholder|icon|suffix|label|disabled|key|ref|className|style|children)$/]",
        "message": "<Input> doesn't accept that prop. Declared props: value, placeholder, icon, suffix, label, disabled."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProgressRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:index|title|state|status|statusBand|showGlyph|key|ref|className|style|children)$/]",
        "message": "<ProgressRow> doesn't accept that prop. Declared props: index, title, state, status, statusBand, showGlyph."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProgressRow'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:done|scoring|queued|failed)$/]",
        "message": "<ProgressRow> state must be one of 'done' | 'scoring' | 'queued' | 'failed'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProgressRow'] > JSXAttribute[name.name='statusBand'] > Literal[value!=/^(?:elite|strong|inconsistent|at-risk|fail)$/]",
        "message": "<ProgressRow> statusBand must be one of 'elite' | 'strong' | 'inconsistent' | 'at-risk' | 'fail'."
      },
      {
        "selector": "JSXOpeningElement[name.name='RubricCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|label|meta|action|selected|disabled|key|ref|className|style|children)$/]",
        "message": "<RubricCard> doesn't accept that prop. Declared props: icon, label, meta, action, selected, disabled."
      },
      {
        "selector": "JSXOpeningElement[name.name='RubricCard'] > JSXAttribute[name.name='icon'] > Literal[value!=/^(?:kick-off|coaching)$/]",
        "message": "<RubricCard> icon must be one of 'kick-off' | 'coaching'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ScoreChip'] > JSXAttribute > JSXIdentifier[name!=/^(?:band|children|key|ref|className|style|children)$/]",
        "message": "<ScoreChip> doesn't accept that prop. Declared props: band, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='ScoreChip'] > JSXAttribute[name.name='band'] > Literal[value!=/^(?:elite|strong|inconsistent|at-risk|fail|na|not-evidenced)$/]",
        "message": "<ScoreChip> band must be one of 'elite' | 'strong' | 'inconsistent' | 'at-risk' | 'fail' | 'na' | 'not-evidenced'."
      },
      {
        "selector": "JSXOpeningElement[name.name='UnobservableNotice'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|children|key|ref|className|style|children)$/]",
        "message": "<UnobservableNotice> doesn't accept that prop. Declared props: label, children."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
