# Copy to .env.local and fill in. .env.local is gitignored; this file is committed,
# so it must never contain a real value.
#
# NOTE: the Supabase *Personal Access Token* (sbp_...) does NOT belong here or in
# .env.local. It is a management credential used only to provision the project, and
# it lives in the Supabase CLI's own credential store via `supabase login --token`.
# The application never reads it.

# ---- model ----
# OpenRouter key with anthropic/claude-opus-5 access.
# Provider is pinned to Anthropic on every call; see CLAUDE.md correction #2 —
# 3 of the 9 endpoints serving this model do not support structured_outputs.
OPENROUTER_API_KEY=

# ---- database ----
# Supabase project: Settings > API
#
# There is deliberately NO anon key. RLS is fully closed with no anon policies;
# every read and write goes through server-side code using the service role, and
# runs are served by GET /api/runs/[id]. A public SELECT policy would make the
# whole runs table enumerable, since the uuid v4 protects a row, not the table.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Postgres password — used only by `supabase db push` / direct psql.
SUPABASE_DB_PASSWORD=

# ---- app ----
# Absolute origin used to build the shareable run URL.
NEXT_PUBLIC_APP_URL=http://localhost:3000
